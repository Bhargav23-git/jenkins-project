pipeline {
    agent {
        label 'agent'
    }
    options{
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '3')) 
    }

    stages {
        stage("App code checkout"){
            steps {
                git branch: 'day1', url:'https://github.com/Bhargav23-git/jenkins-project.git'
            }
        }

        stage("build Image"){
            steps{
                sh "docker build -t webapp:v1 ."
            }
        }

        stage("build Container"){
            steps{
                sh "docker run -dit --name webapp -p 80:80 webapp:v1"
            }
        }
    }
}
